   "source": [
    "import numpy as np\n",
    "\n",
    "def f(x):\n",
    "  return (-x ** 3 + 5 * x - 3) / x\n",
    "\n",
    "a = 1\n",
    "b = 2\n",
    "\n",
    "fa = f(a)\n",
    "fb = f(b)\n",
    "\n",
    "\n",
    "# Nullstellen berechnen\n",
    "e = 1E-10\n",
    "while b-a >= e:\n",
    "  m = (a + b) / 2\n",
    "  fm = f(m)\n",
    "  if fa * fm < 0:\n",
    "    b = m\n",
    "    fb = fm\n",
    "  else:\n",
    "    a = m\n",
    "    fa = fm\n",
    "\n",
    "print(a,b)"
   ]
